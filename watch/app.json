{
  "configVersion": "v3",
  "app": {
    "appId": 1094572,
    "appName": "Trova Telefono",
    "appType": "app",
    "version": {
      "code": 7,
      "name": "1.1.1"
    },
    "icon": "icon.png",
    "vender": "pietro",
    "description": "Fa suonare il telefono dallo speaker anche con auricolari BT collegati, con indicatore di prossimità"
  },
  "permissions": [
    "device:os.compass",
    "device:os.ble",
    "data:os.device.info"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.6.0",
      "target": "3.6.0",
      "minVersion": "3.6"
    }
  },
  "debug": false,
  "targets": {
    "balance2": {
      "module": {
        "page": {
          "pages": [
            "page/index"
          ]
        },
        "app-widget": {
          "widgets": [
            {
              "path": "app-widget/index",
              "icon": "icon.png",
              "name": "Trova Telefono",
              "runtime": {
                "type": "js"
              }
            }
          ]
        },
        "secondary-widget": {
          "widgets": [
            {
              "path": "secondary-widget/index",
              "icon": "icon.png",
              "name": "Trova Telefono",
              "runtime": {
                "type": "js"
              },
              "preview": "preview.png"
            }
          ]
        },
        "app-side": {
          "path": "app-side/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        }
      ]
    }
  },
  "i18n": {
    "it-IT": {
      "appName": "Trova Telefono"
    },
    "en-US": {
      "appName": "Find Phone"
    }
  },
  "defaultLanguage": "it-IT"
}
